# /etc/systemd/system/arena-heartbeat.service  (on your VPS)
[Unit]
Description=AI Casino Arena heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=TICK_URL=https://ai-casino-arena.vercel.app/api/tick?t=f1f704897ad6ab4228418245da7d3aa436ebda1a684baccd
Environment=POLL_SECONDS=5
ExecStart=/bin/bash /opt/arena/heartbeat.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
