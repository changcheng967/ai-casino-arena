# /etc/systemd/system/arena-heartbeat.service  (on your VPS)
[Unit]
Description=AI Casino Arena heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=TICK_URL=https://YOUR-APP.vercel.app/api/tick?t=YOUR_CRON_SECRET
Environment=POLL_SECONDS=5
ExecStart=/bin/bash /opt/arena/heartbeat.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
